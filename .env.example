# Copy to .env.local and set values for your own environment.
POSTGRES_URL=postgresql://postgres:password@host:5432/postgres?sslmode=require
AUTH_SECRET=replace_with_a_long_random_secret
APP_URL=http://localhost:3000
PAYMENTS_MODE=simulated

# Only required when PAYMENTS_MODE=stripe.
STRIPE_SECRET_KEY=sk_test_replace_me
STRIPE_WEBHOOK_SECRET=whsec_replace_me

# Only required to send real invoice emails.
RESEND_API_KEY=re_replace_me
RESEND_FROM_EMAIL="Medi-Clinic <invoices@your-verified-domain.example>"
